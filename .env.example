# Copier ce fichier en .env puis renseigner les valeurs réelles.
# Toutes les variables sont facultatives : les éléments sans valeur sont masqués.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_WHATSAPP_NUMBER=
VITE_LINKEDIN_URL=
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
# URL d'un endpoint acceptant un POST JSON (ex. future API Laravel). Vide = formulaire non connecté.
VITE_CONTACT_ENDPOINT=
