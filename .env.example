# Copier ce fichier en .env puis renseigner les valeurs réelles.
# Toutes les variables sont facultatives : les éléments sans valeur sont masqués.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_WHATSAPP_NUMBER=
VITE_LINKEDIN_URL=https://www.linkedin.com/in/pixforge-studio-128a0044a/
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
# EmailJS (https://dashboard.emailjs.com) : envoi du formulaire de contact.
# Les trois valeurs sont requises ; si l'une manque, le formulaire renvoie vers l'e-mail / WhatsApp.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
